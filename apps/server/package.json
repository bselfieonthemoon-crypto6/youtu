    "@loomic/shared": "workspace:*",
    "@mastra/core": "1.66.0",
    "@mastra/memory": "1.29.0",
    "@mastra/pg": "1.24.0",
    "@supabase/supabase-js": "^2.57.0",
    "fastify": "^5.12.3",
    "fontkit": "2.0.4",
    "google-auth-library": "^10.6.2",
    "jose": "^6.2.2",
    "js-yaml": "^4.3.2",
    "openai": "^6.32.0",
    "pg": "^8.20.0",
    "sharp": "^0.35.4",
    "tar": "^7.5.22",
    "undici": "^7.29.0",
