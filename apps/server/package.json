    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@loomic/config": "workspace:*",
    "@types/fontkit": "2.0.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^3.4.0",
