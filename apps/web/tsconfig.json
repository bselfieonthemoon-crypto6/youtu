{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": false,
    "incremental": false,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    ".next-e2e-3000/types/**/*.ts",
    ".next-e2e-3100/types/**/*.ts",
    ".next-e2e-3200/types/**/*.ts",
    ".next-e2e-3300/types/**/*.ts",
    ".next-e2e-3310/types/**/*.ts",
    ".next-stage7-review-3200/types/**/*.ts",
    ".next-stage8-e2e-3100/types/**/*.ts",
    ".next-stage8-e2e-3300/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    ".next-e2e-3400/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
