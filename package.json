{
  "name": "loomic",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome lint apps/server/src apps/web/src packages/shared/src",
    "format": "biome format --write apps/server/src apps/web/src packages/shared/src",
    "test:workspace": "node --test tests/workspace.test.mjs",
    "test:packages": "turbo run test --concurrency=1",
    "test": "pnpm run test:workspace && pnpm run test:packages",
    "seed": "node scripts/seed-test-accounts.mjs",
    "typecheck": "turbo run typecheck --concurrency=1",
    "model:feynobg:download": "python scripts/download-feynobg.py"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "global-agent": "^4.1.3"
  }
}
